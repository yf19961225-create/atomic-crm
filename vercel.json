{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "experimentalServices": {
    "crm": {
      "root": ".",
      "entrypoint": ".",
      "routePrefix": "/",
      "framework": "vite",
      "buildCommand": "npm run build",
      "functions": {
        "api/website-inquiries.ts": { "maxDuration": 30 }
      }
    },
    "order-pdf": {
      "root": "services/order-pdf-poc",
      "entrypoint": "Dockerfile.vercel",
      "routePrefix": "/api/order-pdf",
      "memory": 2048,
      "maxDuration": 120
    }
  },
  "rewrites": [
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
