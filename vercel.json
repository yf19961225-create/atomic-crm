{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "crm": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "functions": {
        "api/website-inquiries.ts": { "maxDuration": 30 }
      }
    },
    "order-pdf": {
      "root": "services/order-pdf-poc",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/api/order-pdf/(.*)",
      "destination": { "service": "order-pdf" }
    },
    { "source": "/(.*)", "destination": { "service": "crm" } }
  ]
}
